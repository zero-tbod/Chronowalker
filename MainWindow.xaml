<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Chronowalker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Loaded="OnWindowLoaded">
        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="960"
                Margin="20,16,20,22"
                HorizontalAlignment="Stretch"
                Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Uid="HeroTitle"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="HeroSubtitle"
                        MaxWidth="820"
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <InfoBar
                    x:Name="StatusInfoBar"
                    AutomationProperties.AutomationId="StatusInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="14">
                        <TextBlock
                            x:Uid="ConfigurationHeading"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <Grid
                            x:Name="SettingsGrid"
                            ColumnSpacing="20"
                            RowSpacing="14"
                            SizeChanged="OnSettingsGridSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="RightSettingsColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="12">
                                <ComboBox
                                    x:Name="PlatformComboBox"
                                    x:Uid="PlatformComboBox"
                                    AutomationProperties.AutomationId="PlatformComboBox"
                                    DisplayMemberPath="DisplayName"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.PlatformChoices}"
                                    SelectedItem="{x:Bind ViewModel.SelectedPlatform, Mode=TwoWay}"
                                    TabIndex="1" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.DetectedPlatformLabel, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />

                                <ComboBox
                                    x:Name="SegmentsComboBox"
                                    x:Uid="SegmentsComboBox"
                                    AutomationProperties.AutomationId="SegmentsComboBox"
                                    DisplayMemberPath="DisplayName"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.SegmentChoices}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSegment, Mode=TwoWay}"
                                    TabIndex="2" />

                                <CheckBox
                                    x:Name="ExperimentalAcknowledgement"
                                    x:Uid="ExperimentalAcknowledgement"
                                    AutomationProperties.AutomationId="ExperimentalAcknowledgement"
                                    IsChecked="{x:Bind ViewModel.IsExperimentalAcknowledged, Mode=TwoWay}"
                                    TabIndex="3"
                                    Visibility="{x:Bind ViewModel.ExperimentalVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="DeadlineSettings"
                                Grid.Row="1"
                                Spacing="12">
                                <ComboBox
                                    x:Name="DeadlineComboBox"
                                    x:Uid="DeadlineComboBox"
                                    AutomationProperties.AutomationId="DeadlineComboBox"
                                    DisplayMemberPath="DisplayName"
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.DeadlineChoices}"
                                    SelectedItem="{x:Bind ViewModel.SelectedDeadline, Mode=TwoWay}"
                                    TabIndex="4" />

                                <StackPanel
                                    x:Name="CustomDeadlinePanel"
                                    Spacing="5"
                                    Visibility="{x:Bind ViewModel.CustomDeadlineVisibility, Mode=OneWay}">
                                    <NumberBox
                                        x:Name="CustomDeadlineBox"
                                        x:Uid="CustomDeadlineBox"
                                        AutomationProperties.AutomationId="CustomDeadlineBox"
                                        HorizontalAlignment="Stretch"
                                        LargeChange="30"
                                        Maximum="2147483647"
                                        Minimum="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        TabIndex="5"
                                        Value="{x:Bind ViewModel.CustomDeadlineValue, Mode=TwoWay}" />
                                    <TextBlock
                                        x:Uid="CustomDeadlineGuidance"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.DeadlinePreview, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border
                            Padding="0,10,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Uid="ConfigPathHeading"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ConfigPath, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CommandBar
                                x:Name="MainCommandBar"
                                x:Uid="MainCommandBar"
                                AutomationProperties.AutomationId="MainCommandBar"
                                Background="Transparent"
                                DefaultLabelPosition="Right"
                                IsDynamicOverflowEnabled="True">
                                <AppBarButton
                                    x:Name="InstallButton"
                                    x:Uid="InstallButton"
                                    AutomationProperties.AutomationId="InstallButton"
                                    Command="{x:Bind ViewModel.InstallCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanInstall, Mode=OneWay}"
                                    TabIndex="6">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="SaveLocal" />
                                    </AppBarButton.Icon>
                                    <AppBarButton.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="I" Modifiers="Control" />
                                    </AppBarButton.KeyboardAccelerators>
                                </AppBarButton>
                                <AppBarButton
                                    x:Name="RecommendedButton"
                                    x:Uid="RecommendedButton"
                                    AutomationProperties.AutomationId="RecommendedButton"
                                    Command="{x:Bind ViewModel.ApplyRecommendedCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                    TabIndex="7">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Favorite" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    x:Name="RefreshButton"
                                    x:Uid="RefreshButton"
                                    AutomationProperties.AutomationId="RefreshButton"
                                    Command="{x:Bind ViewModel.RefreshDetectionCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                    TabIndex="8">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Refresh" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <CommandBar.SecondaryCommands>
                                    <AppBarButton
                                        x:Name="ExportButton"
                                        x:Uid="ExportButton"
                                        AutomationProperties.AutomationId="ExportButton"
                                        Command="{x:Bind ViewModel.ExportCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                        TabIndex="9" />
                                    <AppBarButton
                                        x:Name="UninstallButton"
                                        x:Uid="UninstallButton"
                                        AutomationProperties.AutomationId="UninstallButton"
                                        Command="{x:Bind ViewModel.UninstallCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                        TabIndex="10" />
                                </CommandBar.SecondaryCommands>
                            </CommandBar>

                            <ProgressRing
                                x:Uid="BusyProgressRing"
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
